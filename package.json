{
  "name": "codexmonitor",
  "version": "0.1.0",
  "description": "监控本地 Codex 运行状态，通过飞书 / 控制台推送通知",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "codex",
    "feishu",
    "notification",
    "monitor"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
